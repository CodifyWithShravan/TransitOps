# Server Port (Render sets this dynamically via $PORT, defaults to 8080)
PORT=8080

# Database Configuration (MySQL or PostgreSQL)
# Example Aiven / TiDB Cloud (MySQL):
# SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<dbname>?sslMode=REQUIRED
# Example Render Managed PostgreSQL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<dbname>
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/transitops_db
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=password

# Debugging Settings
H2_CONSOLE_ENABLED=false
SHOW_SQL=true

# JWT Security (Generate a strong 256-bit hex/base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Optional AI Features (Google Gemini)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional Vector Store (Pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-rag-documents
PINECONE_NAMESPACE=default
